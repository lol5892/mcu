{
  "name": "our-marvel-watchlist",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs && node scripts/verify-public-assets.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "test:sql": "bash scripts/test-sql.sh",
    "test:family": "playwright test -c playwright.family.config.ts",
    "test:edge": "deno check --config supabase/functions/deno.json supabase/functions/media-upload/index.ts supabase/functions/push-dispatch/index.ts && deno test --config supabase/functions/deno.json supabase/functions/_shared/image_test.ts",
    "test:pwa": "playwright test -c playwright.pwa.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "deno": "^2.9.6",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
